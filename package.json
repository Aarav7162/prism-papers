{
  "name": "prism",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source examination cockpit, past-paper solver, and progress tracker",
  "scripts": {
    "dev": "next dev",
    "dev:vite": "vite --port=3000 --host=0.0.0.0",
