    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "archiver": "^7.0.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0",
    "zod": "^3.24.2"
